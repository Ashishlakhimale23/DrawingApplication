{
  "name": "excaildraw",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "db:generate": "cd packages/db && npx prisma migrate dev && npx prisma generate && cd ../..",
    "build:packages":"cd packages/db && npm run build && cd .. && cd common && npm run build && cd ../..",
    "start:web": "cd apps/excalidraw-frontend && npm run dev",
    "start:backend": "cd apps/http-server && npm run dev",
    "start:websocket": "cd apps/ws-server && npm run dev"
  },
  "devDependencies": {
    "@types/node": "^22.15.12",
    "prettier": "^3.4.2",
    "turbo": "^2.4.0",
    "typescript": "5.7.3"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@10.7.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
